# Conexao com o banco. No docker-compose o host e o nome do servico ("db").
DATABASE_URL=postgresql+psycopg://frota:frota@localhost:5432/frota

# Token unico compartilhado com os dispositivos ESP32.
# A aplicacao NAO sobe com este valor vazio: token vazio casaria com header vazio.
DEVICE_TOKEN=troque-este-token
